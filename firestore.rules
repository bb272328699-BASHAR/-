rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // User bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Community reviews on AI tools
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(reviewId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Contact form submissions
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0;
      allow read, update, delete: if false;
    }

    // Smart Outbound Tool Click Tracking Events (Real-time Analytics)
    match /tool_clicks/{clickId} {
      allow read: if true;
      allow create: if isValidId(clickId)
        && request.resource.data.toolSlug is string
        && request.resource.data.toolSlug.size() > 0
        && request.resource.data.targetUrl is string
        && request.resource.data.targetUrl.size() > 0
        && request.resource.data.device is string;
      allow update, delete: if false;
    }

    // Price Drop & Deal Alerts
    match /price_alerts/{alertId} {
      allow read: if true;
      allow create: if isValidId(alertId)
        && request.resource.data.toolSlug is string
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3;
      allow update, delete: if false;
    }

    // Custom AI Stacks Builder
    match /custom_stacks/{stackId} {
      allow read: if true;
      allow create: if isValidId(stackId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.toolSlugs is list;
      allow update, delete: if true;
    }

    // Arabic AI Quality Index Reviews
    match /arabic_reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId)
        && request.resource.data.toolSlug is string
        && request.resource.data.overallScore >= 1
        && request.resource.data.overallScore <= 10;
      allow update, delete: if true;
    }

    // Community Tool Q&A
    match /tool_questions/{questionId} {
      allow read: if true;
      allow create: if isValidId(questionId)
        && request.resource.data.toolSlug is string
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0;
      allow update: if isValidId(questionId) && request.resource.data.question is string;
      allow delete: if false;
    }

    // Connection validation test probe
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
